# App
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:8000

# Database (Local MySQL or Hosted Cloud MySQL like TiDB, Aiven, RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=fixflow_user
DB_PASSWORD=change-me
DB_NAME=fixflow
DB_SSL=false

# Storage: local | database
# Use "local" for local disk development; use "database" for Vercel serverless (stores photos as BLOB in DB)
STORAGE_BACKEND=local

# AI (Rule-based suggestions)
AI_ENABLED=true

